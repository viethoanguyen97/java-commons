<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hovispace</groupId>
        <artifactId>java-commons</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>spring-batch</artifactId>

    <dependencies>
        <!-- Spring Boot Starter for Batch with JDBC — pulls in spring-batch-core,
             spring-boot-autoconfigure, and JDBC-backed JobRepository auto-configuration.
             In Spring Boot 4, the batch starter was split: use spring-boot-starter-batch-jdbc
             for JDBC-backed batch metadata storage (required when writing to a database). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc</artifactId>
        </dependency>

        <!-- Spring Boot core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- JPA support — starter includes auto-config (spring-boot-data-jpa),
             spring-data-jpa, hibernate-core, spring-orm, and JDBC support.
             In Spring Boot 4, JPA auto-configuration was split out of spring-boot-autoconfigure
             into a separate module; the starter ensures it is included. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 in-memory database — used for both batch metadata tables and application data -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 batch test starter — provides @SpringBatchTest,
             JobLauncherTestUtils, and JobRepositoryTestUtils for integration testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-batch-jdbc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
